server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;

    # API proxy to backend.
    # Resolve the backend hostname at request time instead of caching the
    # upstream IP when the config loads — otherwise Nginx returns 502s after
    # the backend is recreated with a new IP (e.g. selective redeploys where
    # the frontend container is left running). Using a variable in proxy_pass
    # forces re-resolution via the resolver below; NGINX_RESOLVER defaults to
    # Docker Compose's embedded DNS and is overridden (e.g. to a public
    # resolver like 8.8.8.8) on platforms without it, such as Railway.
    location /api/ {
        resolver ${NGINX_RESOLVER} valid=5s;
        set $upstream ${BACKEND_URL};
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Never cache index.html so new deployments are always picked up immediately
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        try_files $uri =404;
    }

    # SPA fallback — serve index.html for all non-file routes
    location / {
        try_files $uri $uri/ /index.html;
    }
}
